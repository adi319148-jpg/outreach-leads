# ==============================================================
# OutreachAI Configuration & API Keys
# You can also configure and test these dynamically via the Settings tab in the Web App!
# ==============================================================

PORT=3001
# Optional Persistent Storage Paths (used in Cloud / Docker)
# DATABASE_PATH=/app/data/leads.db
# WWEBJS_AUTH_PATH=/app/data/.wwebjs_auth

# 1. Google Places API (New) Key
# Get your key from: https://console.cloud.google.com/apis/credentials
# Enable 'Places API (New)'
GOOGLE_PLACES_API_KEY=

# 2. YouTube Data API v3 Key
# Get your key from: https://console.cloud.google.com/apis/credentials
# Enable 'YouTube Data API v3'
YOUTUBE_API_KEY=

# 3. Google Gemini API Key (Recommended for AI Pitch generation)
# Get your 100% free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 4. Anthropic Claude API Key (Optional)
# Get key from: https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=

# 5. Resend Email API Key (Free 3,000 emails/month)
# Get free key from: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# 6. SMTP / Gmail App Password (Optional)
# If using Gmail, generate 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Default Pitch Tone: 'friendly' | 'value_offer' | 'collab' | 'direct'
DEFAULT_PITCH_TONE=friendly

# Force Demo Simulation Mode (true/false)
MOCK_MODE_ENABLED=false

