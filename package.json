{
  "name": "leads-platform",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "app": "electron .",
    "app:start": "electron .",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "cd server && npm install && npm run build",
    "build:client": "cd client && npm install && npm run build",
    "build": "npm run build:client && npm run build:server",
    "start": "cd server && node dist/index.js",
    "start:fresh": "npm run build && npm start",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@google/generative-ai": "^0.24.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "axios": "^1.20.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nodemailer": "^9.0.6",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.outreachai.app",
    "productName": "OutreachAI",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName} Setup.${ext}"
    },
    "compression": "normal",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "OutreachAI",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "runAfterFinish": true
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "server/dist/**/*",
      "server/package.json",
      "server/leads.db",
      "!**/*.ts",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "server/leads.db",
        "to": "server/leads.db"
      },
      {
        "from": "client/dist",
        "to": "client/dist"
      },
      {
        "from": "server/dist",
        "to": "server/dist"
      }
    ]
  }
}
